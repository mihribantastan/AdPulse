# Render (free plan) deploy image.
#
# Render'ın ücretsiz planında sadece TEK "Web Service" ücretsizdir; ayrı bir
# "Background Worker" (Python kuyruk dinleyicisi) ücretsiz planda mevcut
# değildir. Bu yüzden Laravel/Octane backend'i ve Python ai_layer worker'ı
# aynı imajda, supervisord ile iki ayrı process olarak birlikte çalıştırıyoruz.
#
# Build context repo kökü olmalı (render.yaml: dockerContext: .) çünkü hem
# backend/ hem ai_layer/ dizinlerinden dosya kopyalamamız gerekiyor.

FROM php:8.4-cli

RUN apt-get update && apt-get install -y \
        libpq-dev \
        libzip-dev \
        unzip \
        git \
        $PHPIZE_DEPS \
        libssl-dev \
        libbrotli-dev \
        python3 \
        python3-venv \
        supervisor \
    && docker-php-ext-install pdo pdo_pgsql pgsql zip pcntl \
    && pecl install swoole \
    && docker-php-ext-enable swoole \
    && rm -rf /var/lib/apt/lists/*

# Kampanya görsel/video yüklemeleri için varsayılan PHP limitleri (2M) yetersiz
RUN { \
        echo 'upload_max_filesize=100M'; \
        echo 'post_max_size=110M'; \
        echo 'memory_limit=256M'; \
    } > /usr/local/etc/php/conf.d/uploads.ini

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# --- Laravel backend ---
WORKDIR /var/www/html
COPY backend/composer.json backend/composer.lock ./
RUN for i in 1 2 3 4 5; do \
        composer install --no-interaction --no-progress --no-dev --optimize-autoloader --no-scripts && break; \
        echo "composer install failed (attempt $i), retrying in 20s..."; sleep 20; \
    done
COPY backend/ ./
RUN composer dump-autoload --optimize \
    && mkdir -p storage/framework/cache storage/framework/sessions storage/framework/views storage/logs \
    && chmod -R 775 storage bootstrap/cache

# --- Python ai_layer worker (izole venv: Debian'ın "externally managed" pip kısıtını atlıyoruz) ---
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
WORKDIR /app/ai_layer
COPY ai_layer/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY ai_layer/*.py ./

COPY docker/supervisord.conf /etc/supervisor/supervisord.conf
COPY docker/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

WORKDIR /var/www/html
EXPOSE 8000
ENTRYPOINT ["/docker-entrypoint.sh"]
